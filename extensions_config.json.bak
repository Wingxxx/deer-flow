{
  "mcpServers": {
    "mcp-server": {
      "enabled": true,
      "type": "stdio",
      "command": "node",
      "args": [
        "mcp-agent-mcp/dist/index.js"
      ],
      "cwd": ".",
      "env": {
        "ADS_API_BASE_URL": "http://192.168.1.139:80",
        "MCP_CONFIG_PATH": "mcp-agent-mcp/.mcp-server/config.json"
      },
      "description": "云桌面管理系统 - 支持终端列表查询、批量开关机、重启锁定、用户管理、镜像管理、策略管理、部门管理"
    },
    "deeprag": {
      "enabled": true,
      "type": "http",
      "url": "http://192.168.1.56:86/mcp",
      "description": "DeepRAG 知识库检索 - 支持文件检索、搜索、同步等功能"
    }
  },
  "skills": {
    "surprise-me": {
      "enabled": false
    },
    "image-generation": {
      "enabled": false
    },
    "podcast-generation": {
      "enabled": false
    },
    "video-generation": {
      "enabled": false
    },
    "claude-to-deerflow": {
      "enabled": false
    }
  }
}
