{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClarificationStructuredV1",
  "description": "Schema for structured clarification data attached to ToolMessage.additional_kwargs._clarification",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": ["clarification"],
      "description": "Discriminant field identifying this as a clarification payload"
    },
    "id": {
      "type": "string",
      "description": "The tool_call_id from the original ask_clarification tool call"
    },
    "question": {
      "type": "string",
      "description": "The clarification question text"
    },
    "clarification_type": {
      "type": "string",
      "enum": ["missing_info", "ambiguous_requirement", "approach_choice", "risk_confirmation", "suggestion"],
      "description": "Categorisation of the clarification request"
    },
    "context": {
      "type": ["string", "null"],
      "description": "Optional background context provided by the model"
    },
    "options": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Suggested response options (may be empty for free-text input)"
    },
    "widget_hint": {
      "type": "string",
      "enum": ["text_input", "option_buttons", "confirm_dialog"],
      "description": "Hint for the frontend on which interactive widget to render"
    },
    "policy": {
      "type": "object",
      "properties": {
        "max_per_turn": { "type": "integer", "default": 3 },
        "cooldown_seconds": { "type": "integer", "default": 30 },
        "timeout_minutes": { "type": "integer", "default": 5 }
      },
      "required": ["max_per_turn", "cooldown_seconds", "timeout_minutes"],
      "description": "Rate-limiting and timeout policy"
    }
  },
  "required": ["type", "id", "question", "clarification_type", "options", "widget_hint", "policy"],
  "additionalProperties": false
}
