{
  "mcpServers": {
    "#": "── 以下为部署示例（使用相对路径 + cwd 绑定确保路径稳定） ──",
    "mcp-server": {
      "enabled": true,
      "type": "stdio",
      "command": "node",
      "args": [
        "mcp-agent-mcp/dist/index.js"
      ],
      "env": {
        "ADS_CONFIG_PATH": "mcp-agent-mcp/.mcp-server/config.json"
      },
      "description": "云桌面管理系统 - 支持终端列表查询、批量开关机、重启锁定、用户管理、镜像管理、策略管理、部门管理"
    },
    "deeprag": {
      "enabled": true,
      "type": "http",
      "url": "http://127.0.0.1:86/mcp",
      "description": "DeepRAG 知识库检索 - 支持文件检索、搜索、同步等功能"
    }
  },
  "skills": {
    "surprise-me": {
      "enabled": false
    },
    "image-generation": {
      "enabled": false
    },
    "podcast-generation": {
      "enabled": false
    },
    "video-generation": {
      "enabled": false
    },
    "claude-to-deerflow": {
      "enabled": false
    }
  }
}
