{
  "mcpInterceptors": [
    "my_package.mcp.auth:build_auth_interceptor"
  ],
  "mcpServers": {
    "github": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "$GITHUB_TOKEN"
      },
      "description": "GitHub MCP server for repository operations"
    },
    "postgres": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost/mydb"
      ],
      "env": {},
      "description": "PostgreSQL database access"
    },
    "#": "── 以下为部署示例（使用相对路径 + cwd 绑定确保路径稳定） ──",
    "mcp-server": {
      "enabled": true,
      "type": "stdio",
      "command": "node",
      "args": [
        "mcp-agent-mcp/dist/index.js"
      ],
      "cwd": "$DEER_FLOW_PROJECT_ROOT",
      "env": {
        "MCP_API_BASE_URL": "$MCP_API_BASE_URL",
        "MCP_CONFIG_PATH": "mcp-agent-mcp/.mcp-server/config.json"
      },
      "description": "云桌面管理系统"
    },
    "deeprag": {
      "enabled": true,
      "type": "http",
      "url": "$DEEPRAG_MCP_URL",
      "description": "DeepRAG 知识库检索引擎"
    }
  },
  "skills": {
    "surprise-me": {
      "enabled": false
    },
    "image-generation": {
      "enabled": false
    },
    "podcast-generation": {
      "enabled": false
    },
    "video-generation": {
      "enabled": false
    },
    "claude-to-deerflow": {
      "enabled": false
    }
  }
}
